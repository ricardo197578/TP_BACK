extends ../layout

block content
  h2 Crear Tienda

  form(action="/tiendas", method="POST")
    div
      label Nombre:
      input(type="text", name="nombre", required)

    div
      label Comercio:
      select(name="comercioId", required)
        option(value="") Seleccionar comercio
        each comercio in comercios
          option(value=comercio.id)= comercio.nombre

    button(type="submit") Guardar
