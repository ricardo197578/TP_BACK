extends ../layout

block content
  h2= tienda ? "Editar Tienda" : "Crear Tienda"

  form(action=action, method="POST")
    div
      label Nombre:
      input(type="text", name="nombre", required, value=tienda ? tienda.nombre : "")

    div
      label Comercio:
      select(name="comercioId", required)
        option(value="") Seleccionar comercio
        each comercio in comercios
          option(value=comercio.id, selected=tienda && tienda.comercioId === comercio.id)= comercio.nombre

    div
      label(for="activo") Activa:
      select(name="activo", id="activo")
        option(value="true", selected=!tienda || tienda.activo) Si
        option(value="false", selected=tienda && !tienda.activo) No

    button(type="submit")= submitLabel
    a(href="/tiendas") Cancelar
