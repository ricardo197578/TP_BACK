extends ../layout

block content
  h2 Crear Comercio

  form(action="/comercios", method="POST")
    div
      label Nombre:
      input(type="text", name="nombre", required)

    div
      label CUIT:
      //input(type="text", name="cuit", required pattern="\d{11}") error
      //input(type="text", name="cuit", required pattern="^\d{11}$")error
      input(type="text", name="cuit", required pattern="^\\d{11}$")

    div
      label Email:
      input(type="email", name="email", required)

    button(type="submit") Guardar
